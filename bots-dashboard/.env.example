# Copy to .env.local for `next dev`. Never commit real values.
# Generate long random strings with: openssl rand -base64 32

BOTDASH_USERNAME=change-me
BOTDASH_PASSWORD=change-me
BOTDASH_SESSION_SECRET=change-me-to-a-long-random-string
BOTDASH_INGEST_TOKEN=change-me-to-a-long-random-string

# Required in production. Create a private Vercel Blob store and connect it.
# Leave empty in local dev to use bots-dashboard/.data instead.
BLOB_READ_WRITE_TOKEN=

# Optional. When both are set, actions are forwarded as soon as they are stored.
# BOTDASH_WEBHOOK_AUTH is the full Authorization header value, for example: Bearer whsec_example
BOTDASH_WEBHOOK_URL=
BOTDASH_WEBHOOK_AUTH=
